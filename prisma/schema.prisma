datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

//-----//-----//-------START USER MODEL- -----//-----//-------
model User {
  id                    String             @id @default(auto()) @map("_id") @db.ObjectId
  firstName             String
  lastName              String?
  phoneNumber           String?
  email                 String             @unique
  password              String
  nationality           String?
  fcmToken              String?
  profileImage          String?
  role                  UserRole           @default(User)
  status                UserStatus         @default(Active)
  totalPay              Float              @default(0)
  accountId             String?
  addMoneyCustomerId    String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  Pet                   Pet[]
  Product               Product[]
  ProductBookingBooking ProductBooking[]
  PaymentActivity       PaymentActivity[]
  FlightBooking         FlightBooking[]
  Review                Review[]
  UserSubscription      UserSubscription[]

  @@map("users")
}

model Pet {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  petType   PetType
  petName   String
  petAge    String
  weight    String
  petImage  String
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pets")
}

// -----//-----//-------END USER MODEL- -----//-----//-------

model Product {
  id                    String           @id @default(auto()) @map("_id") @db.ObjectId
  name                  String           @unique
  price                 Float
  inStock               Int
  description           String
  images                String[] // multiple product images 
  rating                Float?           @default(0) // average rating
  reviews               Review[]
  totalReviews          Int              @default(0)
  petType               PetType[]
  weight                String
  colorOptions          String[]
  suitableFor           String[]
  category              ProductCategory
  fastShipping          String           @default("2-5 business days")
  easyReturns           String           @default("30 Day money back guarantee")
  userId                String           @db.ObjectId
  user                  User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  ProductBookingBooking ProductBooking[]

  @@map("products")
}

model Review {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  reviewerId String @db.ObjectId
  reviewer   User   @relation(fields: [reviewerId], references: [id])

  productId String?  @db.ObjectId
  product   Product? @relation(fields: [productId], references: [id])

  flightBookingId String?        @db.ObjectId
  flightBooking   FlightBooking? @relation(fields: [flightBookingId], references: [id])

  rating    Float
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}

model FlightBooking {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  userId           String           @db.ObjectId
  user             User             @relation(fields: [userId], references: [id])
  from             String
  to               String
  journeyDate      DateTime
  returnDate       DateTime?
  flightStatus     FlightStatus     @default(Oneway)
  flightGoer       String
  paymentId        String
  price            Float
  productBookingId String?
  ProductBooking   ProductBooking[]
  Review           Review[]

  @@map("flightBooking")
}

model ProductBooking {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  productId       String        @db.ObjectId
  // product     Product  @relation(fields: [productId], references: [id])
  userId          String        @db.ObjectId
  user            User          @relation(fields: [userId], references: [id])
  flightBookingId String        @db.ObjectId
  flightBooking   FlightBooking @relation(fields: [flightBookingId], references: [id])
  bookingDate     DateTime      @default(now())
  quantity        Int
  totalPrice      Float
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  // paymentStatus PaymentStatus @default(Unpaid)
  paymentId       String?
  // paymentMethodId String?
  // Product     Product  @relation(fields: [productId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])

  @@map("bookings")
}

model PaymentActivity {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  type      String
  amount    Float
  txId      String?
  productId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_activities")
}

model SubscriptionPlan{
 id String @id @default(auto()) @map("_id") @db.ObjectId
 title String @unique
 subscriptionTitleType SubscriptionTitleType @unique
 priceId String @unique
 productId String @unique
 features Json 
 type  SubscriptionType
 interval String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

}



model UserSubscription{
  id String @id @default(auto()) @map("_id") @db.ObjectId
  subscriptionTitleType SubscriptionTitleType
  userId String @db.ObjectId
  subscriptionId String @db.ObjectId
  priceId String
  subscriptionPayId String
  features Json
  status
}

model Notification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  receiverId String?  @db.ObjectId
  senderId   String?  @db.ObjectId
  title      String?
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("notifications")
}

model Airport {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  city        String?
  airport     String?
  code        String?
  country     String?
  countryCode String?

  @@map("airports")
}

// -----//-----//-------END BOOKING MODEL- -----//-----//-------
enum UserStatus {
  Active
  Blocked
  Deleted
}

enum UserRole {
  User
  Admin
}

enum PetType {
  Dog
  Cat
  Bird
}

enum ProductCategory {
  Food
  Toy
  Accessories
}

enum PaymentStatus {
  Unpaid
  Paid
}

enum FlightStatus {
  Oneway
  Roundway
  Multicity
}

enum SubscriptionTitleType {
  MONTHLY
  YEARLY
}

enum SubscriptionType{
   FREE
   ONETIME
   SUBSCRIPTION
   MONTHLY
   YEARLY
}
