datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

//-----//-----//-------START USER MODEL- -----//-----//-------
model User {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  firstName          String
  lastName           String?
  phoneNumber        String?
  email              String            @unique
  password           String
  nationality        String?
  fcmToken           String?
  profileImage       String?
  role               UserRole          @default(User)
  status             UserStatus        @default(Active)
  totalPay           Float             @default(0)
  accountId          String?
  addMoneyCustomerId String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  Pet                Pet[]
  Product            Product[]
  Booking            Booking[]
  PaymentActivity    PaymentActivity[]

  @@map("users")
}

model Pet {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  petType   PetType
  petName   String
  petAge    String
  weight    String
  petImage  String
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pets")
}

// -----//-----//-------END USER MODEL- -----//-----//-------

model Product {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  name         String          @unique
  price        Float
  inStock      Int
  description  String
  images       String[] // multiple product images 
  rating       Float?          @default(0) // average rating
  reviews      Review[]
  totalReviews Int             @default(0)
  petType      PetType[]
  weight       String
  colorOptions String[]
  suitableFor  String[]
  category     ProductCategory
  fastShipping String          @default("2-5 business days")
  easyReturns  String          @default("30 Day money back guarantee")
  userId       String          @db.ObjectId
  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  Booking      Booking[]

  @@map("products")
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  Product   Product? @relation(fields: [productId], references: [id])
  productId String?  @db.ObjectId
}

model Booking {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  productId       String   @db.ObjectId
  // product     Product  @relation(fields: [productId], references: [id])
  userId          String   @db.ObjectId
  user            User     @relation(fields: [userId], references: [id])
  bookingDate     DateTime @default(now())
  quantity        Int
  totalPrice      Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // paymentStatus PaymentStatus @default(Unpaid)
  paymentId       String?
  paymentMethodId String?
  // Product     Product  @relation(fields: [productId], references: [id])
  product         Product  @relation(fields: [productId], references: [id])

  @@map("bookings")
}

model PaymentActivity {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  type      String
  amount    Float
  txId      String?
  productId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_activities")
}

// -----//-----//-------END BOOKING MODEL- -----//-----//-------
enum UserStatus {
  Active
  Blocked
  Deleted
}

enum UserRole {
  User
  Admin
}

enum PetType {
  Dog
  Cat
  Bird
}

enum ProductCategory {
  Food
  Toy
  Accessories
}

enum PaymentStatus {
  Unpaid
  Paid
}
